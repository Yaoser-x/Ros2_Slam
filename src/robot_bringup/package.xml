  <exec_depend>robot_sensing</exec_depend>
  <exec_depend>robot_control</exec_depend>
  <exec_depend>robot_config</exec_depend>
  <exec_depend>robot_navigation_guard</exec_depend>
  <exec_depend>robot_chassis_ops</exec_depend>
